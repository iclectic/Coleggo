generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CircleState {
  forming
  active
  full
  paused
  archived
}

enum JourneyState {
  scheduled
  awaitingConfirmation
  confirmed
  completed
  cancelled
  missed
  archived
}

enum RequestStatus {
  pending
  accepted
  declined
  cancelled
  expired
}

enum MembershipRole {
  organiser
  driver
  passenger
  backupDriver
}

enum CommuteRole {
  driver
  passenger
  both
}

enum AttendanceStatus {
  travelling
  notTravelling
  unsure
}

enum MessageDeliveryState {
  stored
  flagged
  removed
}

enum ModerationReportStatus {
  submitted
  reviewed
  dismissed
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  notifications   Notification[]
  commuteRequests CommuteRequest[]
  refreshTokens   RefreshToken[]
  messageReports  MessageModerationReport[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workplace {
  id                     String     @id @default(cuid())
  name                   String
  slug                   String     @unique
  domain                 String     @unique
  /// Comma-separated extra allowed email domains beyond the primary domain.
  allowedDomains         String[]   @default([])
  invitationCode         String?    @unique
  verificationValidDays  Int        @default(90)
  createdAt              DateTime   @default(now())
  worksites              Worksite[]

  @@map("workplaces")
}

model Worksite {
  id          String          @id @default(cuid())
  workplaceId String
  name        String
  createdAt   DateTime        @default(now())
  workplace   Workplace       @relation(fields: [workplaceId], references: [id])
  profiles    Profile[]
  circles     CommuteCircle[]

  @@unique([workplaceId, name])
  @@map("worksites")
}

model Profile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  worksiteId         String
  firstName          String
  initials           String
  role               CommuteRole
  homeArea           String
  corridor           String
  days               Int[]
  arrivalMinutes     Int
  departureMinutes   Int
  availableSeats     Int                @default(0)
  vehicleSummary     String?
  workplaceVerified  Boolean            @default(false)
  verifiedAt         DateTime?
  /// Quiet hours start minute-of-day (0-1439). Null means no quiet hours.
  quietHoursStart    Int?
  quietHoursEnd      Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksite           Worksite           @relation(fields: [worksiteId], references: [id])
  memberships        CircleMembership[]
  attendances        Attendance[]
  cancellations      CancellationRecord[]
  sentMessages       Message[]

  @@map("profiles")
}

model CommuteCircle {
  id              String             @id @default(cuid())
  worksiteId      String
  name            String
  shiftLabel      String
  days            Int[]
  departureWindow String
  seats           Int
  state           CircleState        @default(active)
  backupDriverId  String?
  createdAt       DateTime           @default(now())
  worksite        Worksite           @relation(fields: [worksiteId], references: [id])
  memberships     CircleMembership[]
  requests        CommuteRequest[]
  journeys        JourneyOccurrence[]
  messageThread   MessageThread?

  @@map("commute_circles")
}

model CircleMembership {
  id        String         @id @default(cuid())
  circleId  String
  profileId String
  role      MembershipRole
  paused    Boolean        @default(false)
  joinedAt  DateTime       @default(now())
  circle    CommuteCircle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([circleId, profileId])
  @@map("circle_memberships")
}

model CommuteRequest {
  id          String        @id @default(cuid())
  circleId    String
  requesterId String
  type        String
  status      RequestStatus @default(pending)
  message     String?
  createdAt   DateTime      @default(now())
  circle      CommuteCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  requester   User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("commute_requests")
}

model JourneyOccurrence {
  id            String               @id @default(cuid())
  circleId      String
  scheduledFor  DateTime
  state         JourneyState         @default(scheduled)
  driverId      String?
  createdAt     DateTime             @default(now())
  circle        CommuteCircle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  attendances   Attendance[]
  cancellations CancellationRecord[]

  @@unique([circleId, scheduledFor])
  @@index([state, scheduledFor])
  @@map("journey_occurrences")
}

model Attendance {
  id        String            @id @default(cuid())
  journeyId String
  profileId String
  status    AttendanceStatus
  journey   JourneyOccurrence @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([journeyId, profileId])
  @@map("attendances")
}

model CancellationRecord {
  id                 String            @id @default(cuid())
  journeyId          String
  cancelledById      String
  reason             String
  affectedPassengers Int
  createdAt          DateTime          @default(now())
  journey            JourneyOccurrence @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  cancelledBy        Profile           @relation(fields: [cancelledById], references: [id], onDelete: Cascade)

  @@map("cancellation_records")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  method       String
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, key, method, path])
  @@map("idempotency_keys")
}

model MessageThread {
  id        String        @id @default(cuid())
  circleId  String        @unique
  createdAt DateTime      @default(now())
  archived  Boolean       @default(false)
  circle    CommuteCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("message_threads")
}

model Message {
  id               String               @id @default(cuid())
  threadId         String
  senderProfileId  String
  body             String
  deliveryState    MessageDeliveryState @default(stored)
  createdAt        DateTime             @default(now())
  thread           MessageThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender           Profile              @relation(fields: [senderProfileId], references: [id], onDelete: Cascade)
  reports          MessageModerationReport[]

  @@index([threadId, createdAt])
  @@index([senderProfileId, createdAt])
  @@map("messages")
}

model MessageModerationReport {
  id         String                 @id @default(cuid())
  messageId  String
  reporterId String
  reason     String
  status     ModerationReportStatus @default(submitted)
  createdAt  DateTime               @default(now())
  message    Message                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User                   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@map("message_moderation_reports")
}
